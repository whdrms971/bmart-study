# 이 파일에는 키 "이름"만 둔다. 실제 값은 사용자 환경변수 또는 커밋되지 않는 .env 에 둔다.

# 서버 전용 카카오 REST API 키 (Local 주소검색 / 카카오모빌리티 길찾기). 앱·웹·로그에 절대 노출 금지
KAKAO_REST_API_KEY=

# 서버 프로필 (local-test 에서만 Mock OMS/MFC·시뮬레이터·테스트 로그인 활성화)
SPRING_PROFILES_ACTIVE=local-test

# 테스트 계정 공용 패스코드 (local-test 로그인용, 8자 이상). 미설정 시 테스트 로그인 비활성
DELIVERY_TEST_PASSCODE=

# JWT 서명 비밀 (32바이트 이상). 미설정 시 서버 기동마다 임의 생성(재기동 시 재로그인 필요)
DELIVERY_AUTH_SECRET=

# 내부(OMS/MFC→Delivery) 호출 토큰. 미설정 시 기동마다 임의 생성(동일 JVM Mock만 사용 가능)
DELIVERY_INTERNAL_TOKEN=

# Flutter 앱: apps/<app>/kakao.local.json 에 {"KAKAO_NATIVE_APP_KEY":"...","API_BASE_URL":"http://<PC_LAN_IP>:8080"}
